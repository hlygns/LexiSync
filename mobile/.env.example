# Copy this file to .env. Restart "npx expo start" after changing it.
#
# Android emulator: 10.0.2.2 is the emulator's name for your computer's localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#
# Real phone with Expo Go: use your computer's Wi-Fi IP instead (run "ipconfig"), e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
